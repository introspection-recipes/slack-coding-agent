{
  "display_information": {
    "name": "Introspection Coding Agent",
    "description": "Runs repository coding tasks from Slack threads",
    "background_color": "#111827"
  },
  "features": {
    "bot_user": {
      "display_name": "Coding Agent",
      "always_online": false
    }
  },
  "oauth_config": {
    "redirect_urls": [
      "${SLACK_OAUTH_REDIRECT_URL}"
    ],
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "channels:join",
        "chat:write",
        "groups:history",
        "im:history",
        "mpim:history",
        "reactions:write",
        "users:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "${SLACK_EVENTS_REQUEST_URL}",
      "bot_events": [
        "app_mention",
        "message.channels",
        "message.groups",
        "message.im",
        "message.mpim"
      ]
    },
    "interactivity": {
      "is_enabled": false
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
